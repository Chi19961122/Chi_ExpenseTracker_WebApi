<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 產生 XML 文件註解供 Swagger 使用 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 1591：不強制每個 public 成員都要有 XML 註解 -->
    <NoWarn>$(NoWarn);1591</NoWarn>
    <UserSecretsId>chi-expensetracker-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="15.1.3" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chi.ExpenseTracker.Common\Chi.ExpenseTracker.Common.csproj" />
    <ProjectReference Include="..\Chi.ExpenseTracker.Repositories\Chi.ExpenseTracker.Repositories.csproj" />
    <ProjectReference Include="..\Chi.ExpenseTracker.Services\Chi.ExpenseTracker.Services.csproj" />
  </ItemGroup>

</Project>
